{
  "name": "prabhupada-vani-desktop",
  "productName": "Prabhupada Vani",
  "version": "1.0.9",
  "description": "Srila Prabhupada lecture search app \u2014 Windows desktop build",
  "main": "main.js",
  "private": true,
  "license": "ISC",
  "scripts": {
    "export": "node scripts/export-web.js",
    "start": "electron .",
    "dev": "npm run export && electron .",
    "build": "npm run export",
    "dist": "npm run export && electron-builder --win",
    "dist:dir": "npm run export && electron-builder --win --dir --x64",
    "dist:arm64": "npm run export && electron-builder --win --arm64"
  },
  "devDependencies": {
    "electron": "44.4.4",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.prabhupadavani.desktop",
    "productName": "Prabhupada Vani",
    "copyright": "Lectures sourced from vanisource.org",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "web/**/*",
      "build/icon.png",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prabhupada Vani",
      "artifactName": "PrabhupadaVani-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PrabhupadaVani-${version}-portable.${ext}"
    }
  },
  "author": "Prabhupada Vani"
}
